datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  APPLICANT
  APPROVER
  ADMIN
}

enum RequestStatus {
  SUBMITTED
  IN_REVIEW
  REVISION_REQUIRED
  APPROVED
  REJECTED
}

enum TaskStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  fullName   String
  role       Role     @default(APPLICANT)
  department String
  createdAt  DateTime @default(now())

  requests   Request[]
  tasks      WorkflowTask[]
  auditLogs  AuditLog[]
}

model Request {
  id            String        @id @default(uuid())
  applicantId   String
  title         String
  category      String
  status        RequestStatus @default(SUBMITTED)
  documentUrl   String
  extractedData Json          @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  applicant     User          @relation(fields: [applicantId], references: [id])
  tasks         WorkflowTask[]
  auditLogs     AuditLog[]
}

model WorkflowTask {
  id           String     @id @default(uuid())
  requestId    String
  assignedRole String
  assignedToId String?
  stepOrder    Int
  status       TaskStatus @default(PENDING)
  comments     String?
  createdAt    DateTime   @default(now())

  request      Request    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assignedTo   User?      @relation(fields: [assignedToId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  requestId String
  actorId   String
  action    String
  metadata  Json     @default("{}")
  timestamp DateTime @default(now())

  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor     User     @relation(fields: [actorId], references: [id])
}